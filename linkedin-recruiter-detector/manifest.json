{
  "manifest_version": 3,
  "name": "LinkedIn Recruiter Notification Detector",
  "version": "3.0.0",
  "description": "Detects LinkedIn Recruiter notifications, screens candidates via AI, and pushes qualified ones to Google Sheets.",
  "permissions": [
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/recruiter/*",
        "https://www.linkedin.com/talent/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/talent/profile/*",
        "https://www.linkedin.com/talent/hire/*",
        "https://www.linkedin.com/talent/search/profile/*",
        "https://www.linkedin.com/recruiter/profile/*",
        "https://www.linkedin.com/recruiter/hiring/*",
        "https://www.linkedin.com/recruiter/search/*",
        "https://www.linkedin.com/in/*"
      ],
      "js": ["profile-scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
